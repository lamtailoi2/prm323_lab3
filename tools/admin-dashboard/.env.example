# Local copy: tools/admin-dashboard/.env.local (gitignored).
# On Vercel, set the same names in Project → Settings → Environment Variables.

# Firebase web app config (safe to expose; it is the public app config).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=prm-lab3.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=prm-lab3
VITE_FIREBASE_APP_ID=

# Comma-separated Google accounts allowed to use the dashboard.
ADMIN_EMAILS=

# Optional: Firebase project id override.
# INTERNLY_PROJECT_ID=prm-lab3

# Optional: GA4 realtime property (numeric id, not G-...).
# GA4_PROPERTY_ID=

# Server-side credential, one of:
#   FIREBASE_SERVICE_ACCOUNT_BASE64=<base64 of the service-account JSON>
#   FIREBASE_SERVICE_ACCOUNT=<raw JSON>
#   INTERNLY_ADMIN_SA=C:\Users\<you>\.internly-admin\service-account.json
