# ARTEMIS E2E settings. Copy to e2e_test/.env (never commit it).
#
# The multimodal model API key (Gemini / Claude / GPT-4o / Qwen-VL) is NOT set
# here: it belongs to the ARTEMIS host (your google/artemis checkout, see its
# own .env.example), which runs the agent and drives the device.

# ARTEMIS daemon started with ./start.sh (default http://127.0.0.1:8000)
ARTEMIS_BASE_URL=http://127.0.0.1:8000
# Optional bearer token if the daemon sits behind an authenticating proxy
ARTEMIS_TOKEN=
# Device or emulator serial from `adb devices`, e.g. emulator-5554
DEVICE_SERIAL=
# flash for regression runs; pro only for the exploratory session
ARTEMIS_PROFILE=flash
# Android applicationId of the app under test
APP_PACKAGE=com.group3.internly
# Dedicated Google test account, already added on the device (no password here)
TEST_ACCOUNT_EMAIL=
