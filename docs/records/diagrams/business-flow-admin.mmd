flowchart LR
  subgraph ADMIN["① Admin"]
    direction TB
    D0(["Mở dashboard<br/>127.0.0.1 hoặc Vercel"]) --> D1["Google sign-in"]
    D1 --> D2{"Email trong ADMIN_EMAILS?<br/>BR-N1"}
