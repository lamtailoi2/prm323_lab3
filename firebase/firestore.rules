rules_version = '2';

// Internly — Firestore Security Rules (final; set up once).
//
// Data ownership (docs/architecture.md §6): every document belongs to exactly
// one user and lives under users/{uid}: profile, saved internships,
// applications (students track their own statuses), notifications, report
// metadata. Internship listings are not stored here; they come from SerpAPI.
//
// A signed-in user can read and write only their own subtree, including any
// subcollection added later, so features never need a rules change. Every
// other path is denied. Publish: Firebase console → Firestore → Rules → paste
// this file → Publish (or `firebase deploy --only firestore:rules`).
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Keeps a single document small (Firestore also caps documents at 1 MiB).
    function isReasonableWrite() {
      return request.resource.data.size() <= 50;
    }

    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && isReasonableWrite();

      match /{document=**} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && isReasonableWrite();
      }
    }
  }
}
