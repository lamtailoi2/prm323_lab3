# Build-time settings for the Flutter app.
#
# Flutter does NOT read .env at runtime. These values are passed to the
# compiler and read with String.fromEnvironment(...):
#
#   cp .env.example .env            # then fill in the values (never commit .env)
#   flutter run --dart-define-from-file=.env
#   flutter build apk --dart-define-from-file=.env
#
# Values end up inside the built app, so only put keys here that are safe to
# ship in an APK (no service-account keys, no secrets of paid accounts).
# E2E test settings (ARTEMIS, model API key, test account) live separately in
# e2e_test/.env.example.

# SerpAPI key for internship search (Google Jobs engine). https://serpapi.com/manage-api-key
SERPAPI_KEY=

# Cloudinary (free plan) for CV and PDF report uploads. Cloud name and an
# UNSIGNED upload preset only. Never put the Cloudinary API secret here.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=
