# Widget Preview related
.widget_preview/

# ---- Internly: secrets and local tooling (never commit) ----
# Firebase app config (firebase_options.dart, google-services.json,
# GoogleService-Info.plist) is NOT secret and may be committed; see
# docs/firebase-setup.md. Privileged credentials below must never be.
.env
.env.*
!.env.example
*service-account*.json
*-firebase-adminsdk-*.json
*.p8
*.p12
*.mobileprovision
key.properties
*.keystore
*.jks

# Firebase CLI / emulator local files
.firebase/
.firebaserc.local
firebase-debug.log*
firestore-debug.log*
ui-debug.log*

# ARTEMIS E2E local settings (model API key, test account, device serial)
e2e_test/.env
e2e_test/.venv/
e2e_test/.pytest_cache/
e2e_test/artifacts/
__pycache__/
# Claude Code local state
.claude/settings.local.json
.claude/scheduled_tasks.lock
# Cloud Functions build output and dependencies
functions/node_modules/
functions/lib/

# Local admin dashboard (tools/admin-dashboard)
tools/admin-dashboard/node_modules/
tools/admin-dashboard/.env

# Firebase Functions emulator secrets (real keys; use Secret Manager when deployed)
functions/.secret.local
functions/.env.local

# Local agent skills (installed per machine; not part of the app)
.agents/
skills-lock.json
